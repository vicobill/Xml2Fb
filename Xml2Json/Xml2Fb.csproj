<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AotAssemblies>true</AotAssemblies>
    <BaseOutputPath>E:\project\my-tools\Xml2FbSchemaGenerator\bin</BaseOutputPath>
    <PublishAot>False</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <StripSymbols>true</StripSymbols>
    <PublishTrimmed>False</PublishTrimmed>
    <CETCompat>false</CETCompat> <!--user mode apc-->
  </PropertyGroup>
  <ItemGroup>
    <None Remove="FbGrammar\example.fbs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Xml2Fb.Shared\Xml2Fb.Shared.csproj" />
    <ProjectReference Include="..\Newtonsoft.Json\Newtonsoft.Json.csproj" />
  </ItemGroup>
</Project>